# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=method_app
DB_USER=method_user
DB_PASSWORD=your_secure_password_here

# Security Secrets (Generate with: openssl rand -hex 32)
SESSION_SECRET=your_session_secret_here_generate_secure_random_value
JWT_SECRET=your_jwt_secret_here_generate_secure_random_value

# File Upload Configuration
AVATAR_STORAGE=./uploads
AVATAR_MAX_SIZE=2097152  # 2MB in bytes

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8000

# Logging
LOG_LEVEL=info

